# Cấu hình cổng và môi trường máy chủ
PORT=3000
NODE_ENV=development

# Khóa Google AI (Gemini) API Key — Bắt buộc để thực hiện các hành động AI thật
# Lấy key miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=

# Thư mục lưu trữ tệp tin tải lên (PL1, SGK, KHDH cũ, Mauga.docx)
STORAGE_DIR=./storage/uploads
EXPORTS_DIR=./storage/exports

# Cấu hình Cơ sở dữ liệu SQLite / File-backed Typed Store
DB_PATH=./storage/database.json

# Cấu hình bảo mật session Google OAuth
SESSION_SECRET=khdh_v12_rc2_secure_session_secret_key
